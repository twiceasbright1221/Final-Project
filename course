import java.util.ArrayList;

/**
 * Course.java
 * Represents a course a student is enrolled in.
 * Keeps track of assignments and calculates the final grade.
 *
 * Kaleb Hunter
 * SDEV 200 - Prof. Newell
 */
public class Course {

    // Fields
    private String courseName;
    private String courseCode;
    private int creditHours;
    private ArrayList<Assignment> assignments;
    private double finalGrade;

    // Constructor
    public Course(String courseName, String courseCode, int creditHours) {
        this.courseName = courseName;
        this.courseCode = courseCode;
        this.creditHours = creditHours;
        this.assignments = new ArrayList<>();
        this.finalGrade = 0.0;
    }

    // Getters
    public String getCourseName()              { return courseName; }
    public String getCourseCode()              { return courseCode; }
    public int getCreditHours()                { return creditHours; }
    public ArrayList<Assignment> getAssignments() { return assignments; }
    public double getFinalGrade()              { return finalGrade; }

    // Setters
    public void setCourseName(String courseName)   { this.courseName = courseName; }
    public void setCourseCode(String courseCode)   { this.courseCode = courseCode; }
    public void setCreditHours(int creditHours)    { this.creditHours = creditHours; }

    // Adds an assignment to the course
    public void addAssignment(Assignment assignment) {
        assignments.add(assignment);
    }

    // Calculates the final grade based on total points earned vs total points possible
    public double calculateFinalGrade() {
        double totalEarned = 0;
        double totalPossible = 0;

        for (Assignment a : assignments) {
            totalEarned += a.getPointsEarned();
            totalPossible += a.getPointsPossible();
        }

        if (totalPossible > 0) {
            finalGrade = (totalEarned / totalPossible) * 100;
        }

        return finalGrade;
    }

    @Override
    public String toString() {
        return courseCode + " - " + courseName + " (" + creditHours + " credits)"
                + " | Grade: " + String.format("%.1f", finalGrade) + "%";
    }
}